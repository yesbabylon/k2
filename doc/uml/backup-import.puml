@startuml backup-import

b2 -> "k2": /instance/create-token
note right: creates a token and a temporary ftp user

"k2" --> b2: token and ftp credentials

b2 -> "k2": ftp connect

"k2" -[#blue]> b2: <font color="blue">import backup</font>

b2 -> "k2": ftp close

b2 -> "k2": /instance/release-token
note right: deletes token and temporary ftp user

"k2" --> b2: "token_released"

@enduml
